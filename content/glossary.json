{
  "terms": [
    { "id": "cluster", "ko": "클러스터", "en": "Cluster", "cat": "아키텍처", "scope": "core", "desc": "컨테이너화된 앱을 실행하는 노드들과, 이를 관리하는 컨트롤 플레인을 합친 단위입니다.", "doc": "https://kubernetes.io/docs/concepts/architecture/" },
    { "id": "node", "ko": "노드", "en": "Node", "cat": "아키텍처", "scope": "core", "desc": "파드가 실제로 실행되는 작업 머신(물리 서버, VM, minikube에서는 컨테이너)입니다. kubelet과 kube-proxy, 컨테이너 런타임이 실행됩니다.", "doc": "https://kubernetes.io/docs/concepts/architecture/nodes/" },
    { "id": "control-plane", "ko": "컨트롤 플레인", "en": "Control Plane", "cat": "아키텍처", "scope": "core", "desc": "클러스터의 원하는 상태를 저장하고 결정을 내리는 구성 요소 묶음입니다. kube-apiserver, etcd, kube-scheduler, kube-controller-manager로 이루어집니다.", "doc": "https://kubernetes.io/docs/concepts/overview/components/" },
    { "id": "kube-apiserver", "ko": "API 서버", "en": "kube-apiserver", "cat": "아키텍처", "scope": "core", "desc": "모든 요청이 거치는 클러스터의 관문입니다. 인증·인가·어드미션을 거쳐 객체를 etcd에 저장합니다.", "doc": "https://kubernetes.io/docs/concepts/architecture/#kube-apiserver" },
    { "id": "etcd", "ko": "etcd", "en": "etcd", "cat": "아키텍처", "scope": "core", "desc": "클러스터의 모든 객체를 저장하는 일관성 있는 키-값 저장소입니다. 백업 대상 1순위입니다.", "doc": "https://kubernetes.io/docs/tasks/administer-cluster/configure-upgrade-etcd/" },
    { "id": "scheduler", "ko": "스케줄러", "en": "kube-scheduler", "cat": "아키텍처", "scope": "core", "desc": "아직 노드가 정해지지 않은 파드를 보고, 자원·제약 조건을 따져 실행할 노드를 고릅니다.", "doc": "https://kubernetes.io/docs/concepts/scheduling-eviction/kube-scheduler/" },
    { "id": "controller-manager", "ko": "컨트롤러 매니저", "en": "kube-controller-manager", "cat": "아키텍처", "scope": "core", "desc": "Deployment·ReplicaSet·Node 등 여러 컨트롤러를 실행해 현재 상태를 원하는 상태로 계속 맞춥니다.", "doc": "https://kubernetes.io/docs/concepts/architecture/controller/" },
    { "id": "kubelet", "ko": "kubelet", "en": "kubelet", "cat": "아키텍처", "scope": "core", "desc": "각 노드에서 실행되는 에이전트입니다. 자기 노드에 배정된 파드의 컨테이너를 런타임에 실행시키고 상태를 보고합니다.", "doc": "https://kubernetes.io/docs/reference/command-line-tools-reference/kubelet/" },
    { "id": "kube-proxy", "ko": "kube-proxy", "en": "kube-proxy", "cat": "네트워크", "scope": "core", "desc": "노드에서 Service의 가상 IP로 오는 트래픽을 실제 파드로 전달하는 규칙(iptables, nftables 등)을 관리합니다.", "doc": "https://kubernetes.io/docs/reference/networking/virtual-ips/" },
    { "id": "container-runtime", "ko": "컨테이너 런타임", "en": "Container Runtime", "cat": "아키텍처", "scope": "ecosystem", "desc": "kubelet의 요청(CRI)을 받아 컨테이너를 실제로 실행하는 소프트웨어입니다. containerd, CRI-O 등이 있습니다. minikube v1.39.0의 기본값은 containerd입니다.", "doc": "https://kubernetes.io/docs/setup/production-environment/container-runtimes/" },
    { "id": "cni", "ko": "CNI 플러그인", "en": "Container Network Interface", "cat": "네트워크", "scope": "ecosystem", "desc": "파드에 IP를 주고 파드 간 통신을 연결하는 네트워크 플러그인 규격입니다. NetworkPolicy 집행 여부는 CNI 구현에 따라 다릅니다.", "doc": "https://kubernetes.io/docs/concepts/extend-kubernetes/compute-storage-net/network-plugins/" },
    { "id": "calico", "ko": "Calico", "en": "Calico", "cat": "네트워크", "scope": "ecosystem", "desc": "NetworkPolicy를 집행하는 CNI 구현 중 하나입니다. minikube에서는 --cni=calico로 설치합니다(minikube v1.39.0 기준 v3.32.2).", "doc": "https://minikube.sigs.k8s.io/docs/handbook/network_policy/" },
    { "id": "minikube", "ko": "minikube", "en": "minikube", "cat": "도구", "scope": "ecosystem", "desc": "로컬 PC에 학습·개발용 Kubernetes 클러스터를 만드는 도구입니다. 이 사이트의 기본 실습 환경입니다.", "doc": "https://minikube.sigs.k8s.io/docs/" },
    { "id": "kubectl", "ko": "kubectl", "en": "kubectl", "cat": "도구", "scope": "core", "desc": "API 서버에 요청을 보내는 공식 명령줄 도구입니다. 클러스터 버전과 마이너 1 차이 이내를 사용합니다.", "doc": "https://kubernetes.io/docs/reference/kubectl/" },
    { "id": "kubeconfig", "ko": "kubeconfig와 컨텍스트", "en": "kubeconfig / context", "cat": "도구", "scope": "core", "desc": "kubectl이 어느 클러스터에 어떤 사용자로 접속할지 적은 파일(~/.kube/config)입니다. 컨텍스트는 클러스터·사용자·기본 네임스페이스의 묶음입니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/organize-cluster-access-kubeconfig/" },
    { "id": "manifest", "ko": "매니페스트", "en": "Manifest", "cat": "기본 객체", "scope": "core", "desc": "만들고 싶은 객체의 원하는 상태를 YAML이나 JSON으로 적은 파일입니다. apiVersion, kind, metadata, spec으로 구성됩니다.", "doc": "https://kubernetes.io/docs/concepts/overview/working-with-objects/" },
    { "id": "declarative", "ko": "선언형 관리", "en": "Declarative Management", "cat": "기본 객체", "scope": "core", "desc": "무엇을 할지 명령하는 대신 원하는 상태를 적어 두면 컨트롤러가 현재 상태를 그에 맞추는 방식입니다. kubectl apply가 대표적입니다.", "doc": "https://kubernetes.io/docs/tasks/manage-kubernetes-objects/declarative-config/" },
    { "id": "pod", "ko": "파드", "en": "Pod", "cat": "워크로드", "scope": "core", "desc": "함께 배치되어 네트워크와 저장소를 공유하는 하나 이상의 컨테이너 묶음이며, Kubernetes가 배포하는 가장 작은 단위입니다.", "doc": "https://kubernetes.io/docs/concepts/workloads/pods/" },
    { "id": "deployment", "ko": "디플로이먼트", "en": "Deployment", "cat": "워크로드", "scope": "core", "desc": "상태가 없는 앱의 레플리카 수와 버전을 선언하는 객체입니다. ReplicaSet을 만들어 롤링 업데이트와 롤백을 관리합니다.", "doc": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/" },
    { "id": "replicaset", "ko": "레플리카셋", "en": "ReplicaSet", "cat": "워크로드", "scope": "core", "desc": "같은 템플릿의 파드를 지정한 개수만큼 유지합니다. 보통 Deployment가 만들고 관리하므로 직접 다룰 일은 적습니다.", "doc": "https://kubernetes.io/docs/concepts/workloads/controllers/replicaset/" },
    { "id": "statefulset", "ko": "스테이트풀셋", "en": "StatefulSet", "cat": "워크로드", "scope": "core", "desc": "파드마다 고정된 이름과 전용 볼륨이 필요한 상태 저장 앱을 위한 워크로드입니다.", "doc": "https://kubernetes.io/docs/concepts/workloads/controllers/statefulset/" },
    { "id": "service", "ko": "서비스", "en": "Service", "cat": "네트워크", "scope": "core", "desc": "라벨 셀렉터로 고른 파드 묶음에 변하지 않는 이름과 가상 IP를 붙여 주는 객체입니다. 파드가 바뀌어도 같은 주소로 접근할 수 있습니다.", "doc": "https://kubernetes.io/docs/concepts/services-networking/service/" },
    { "id": "clusterip", "ko": "ClusterIP", "en": "ClusterIP", "cat": "네트워크", "scope": "core", "desc": "Service의 기본 유형입니다. 클러스터 안에서만 접근할 수 있는 가상 IP를 할당합니다.", "doc": "https://kubernetes.io/docs/concepts/services-networking/service/#type-clusterip" },
    { "id": "nodeport", "ko": "NodePort", "en": "NodePort", "cat": "네트워크", "scope": "core", "desc": "모든 노드의 같은 포트(기본 30000–32767)로 Service를 노출하는 유형입니다. minikube에서는 minikube service --url로 접속 주소를 얻습니다.", "doc": "https://kubernetes.io/docs/concepts/services-networking/service/#type-nodeport" },
    { "id": "endpointslice", "ko": "엔드포인트슬라이스", "en": "EndpointSlice", "cat": "네트워크", "scope": "core", "desc": "Service 뒤에 있는 실제 파드 IP와 준비 상태 목록입니다. Service에 연결이 안 될 때 가장 먼저 확인합니다.", "doc": "https://kubernetes.io/docs/concepts/services-networking/endpoint-slices/" },
    { "id": "cluster-dns", "ko": "클러스터 DNS", "en": "Cluster DNS (CoreDNS)", "cat": "네트워크", "scope": "addon", "desc": "Service 이름을 IP로 바꿔 주는 DNS 애드온입니다. 같은 네임스페이스에서는 서비스 이름만, 다른 네임스페이스는 <서비스>.<네임스페이스>로 접근합니다.", "doc": "https://kubernetes.io/docs/concepts/services-networking/dns-pod-service/" },
    { "id": "namespace", "ko": "네임스페이스", "en": "Namespace", "cat": "기본 객체", "scope": "core", "desc": "한 클러스터 안에서 객체 이름과 권한·할당량을 나누는 논리적 구역입니다. 실습마다 전용 네임스페이스를 만들어 정리를 쉽게 합니다.", "doc": "https://kubernetes.io/docs/concepts/overview/working-with-objects/namespaces/" },
    { "id": "label", "ko": "라벨", "en": "Label", "cat": "기본 객체", "scope": "core", "desc": "객체에 붙이는 키-값 쌍입니다. 셀렉터로 객체를 고르는 기준이 됩니다.", "doc": "https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/" },
    { "id": "selector", "ko": "셀렉터", "en": "Selector", "cat": "기본 객체", "scope": "core", "desc": "라벨 조건으로 객체를 고르는 식입니다. Deployment와 Service는 셀렉터로 자신이 관리하거나 연결할 파드를 찾습니다.", "doc": "https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/#label-selectors" },
    { "id": "annotation", "ko": "어노테이션", "en": "Annotation", "cat": "기본 객체", "scope": "core", "desc": "선택 기준으로 쓰지 않는 부가 정보를 객체에 적어 두는 키-값입니다. 도구가 기록용으로 많이 씁니다.", "doc": "https://kubernetes.io/docs/concepts/overview/working-with-objects/annotations/" },
    { "id": "rolling-update", "ko": "롤링 업데이트", "en": "Rolling Update", "cat": "배포", "scope": "core", "desc": "새 버전 파드를 조금씩 늘리고 이전 버전을 조금씩 줄여 중단 없이 교체하는 Deployment의 기본 전략입니다.", "doc": "https://kubernetes.io/docs/concepts/workloads/controllers/deployment/#rolling-update-deployment" },
    { "id": "rollout", "ko": "롤아웃", "en": "Rollout", "cat": "배포", "scope": "core", "desc": "Deployment가 새 파드 템플릿을 반영해 가는 과정입니다. kubectl rollout status·history·undo로 확인하고 되돌립니다.", "doc": "https://kubernetes.io/docs/reference/kubectl/generated/kubectl_rollout/" },
    { "id": "event", "ko": "이벤트", "en": "Event", "cat": "관측", "scope": "core", "desc": "스케줄링, 이미지 내려받기, 재시작 같은 일이 일어날 때 컴포넌트가 남기는 기록입니다. 기본 보존 시간은 1시간입니다.", "doc": "https://kubernetes.io/docs/reference/kubernetes-api/cluster-resources/event-v1/" },
    { "id": "logs", "ko": "컨테이너 로그", "en": "Container Logs", "cat": "관측", "scope": "core", "desc": "컨테이너가 표준 출력·표준 오류로 쓴 내용입니다. kubectl logs로 보고, --previous로 재시작 전 로그를 봅니다.", "doc": "https://kubernetes.io/docs/concepts/cluster-administration/logging/" },
    { "id": "imagepullbackoff", "ko": "이미지 풀 백오프", "en": "ImagePullBackOff", "cat": "관측", "scope": "core", "desc": "이미지를 내려받지 못해 재시도 간격을 늘리며 기다리는 상태입니다. 이미지 이름·태그 오타, 레지스트리 인증, 네트워크를 확인합니다.", "doc": "https://kubernetes.io/docs/concepts/containers/images/#imagepullbackoff" },
    { "id": "crashloopbackoff", "ko": "크래시루프 백오프", "en": "CrashLoopBackOff", "cat": "관측", "scope": "core", "desc": "컨테이너가 시작 직후 계속 종료되어 재시작 간격을 늘리며 기다리는 상태입니다. kubectl logs --previous로 원인을 찾습니다.", "doc": "https://kubernetes.io/docs/tasks/debug/debug-application/debug-pods/" },
    { "id": "configmap", "ko": "컨피그맵", "en": "ConfigMap", "cat": "설정", "scope": "core", "desc": "비밀이 아닌 설정 값을 키-값으로 저장해 파드에 환경 변수나 파일로 주입하는 객체입니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/configmap/" },
    { "id": "secret", "ko": "시크릿", "en": "Secret", "cat": "설정", "scope": "core", "desc": "비밀번호·토큰 같은 민감한 값을 담는 객체입니다. 기본값은 base64 인코딩일 뿐 암호화가 아니므로 RBAC와 저장 시 암호화를 함께 설정해야 합니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/secret/" },
    { "id": "probe", "ko": "프로브", "en": "Probe", "cat": "설정", "scope": "core", "desc": "kubelet이 컨테이너 상태를 주기적으로 검사하는 방법입니다. httpGet, tcpSocket, exec, grpc 방식이 있습니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/liveness-readiness-startup-probes/" },
    { "id": "readiness", "ko": "준비성 프로브", "en": "Readiness Probe", "cat": "설정", "scope": "core", "desc": "실패하면 파드를 Service 엔드포인트에서 빼서 트래픽을 받지 않게 합니다. 컨테이너를 재시작하지는 않습니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/liveness-readiness-startup-probes/#readiness-probe" },
    { "id": "liveness", "ko": "활성 프로브", "en": "Liveness Probe", "cat": "설정", "scope": "core", "desc": "실패가 이어지면 kubelet이 컨테이너를 재시작합니다. 응답 불능 상태에서 스스로 회복하게 할 때 씁니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/liveness-readiness-startup-probes/#liveness-probe" },
    { "id": "startup", "ko": "시작 프로브", "en": "Startup Probe", "cat": "설정", "scope": "core", "desc": "성공할 때까지 다른 프로브를 멈춰 두어, 기동이 느린 앱이 시작 중에 재시작되지 않게 합니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/liveness-readiness-startup-probes/#startup-probe" },
    { "id": "requests", "ko": "자원 요청", "en": "Resource Requests", "cat": "자원", "scope": "core", "desc": "컨테이너가 쓸 것으로 예약하는 CPU·메모리 양입니다. 스케줄러는 요청량을 기준으로 노드를 고릅니다.", "doc": "https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/" },
    { "id": "limits", "ko": "자원 제한", "en": "Resource Limits", "cat": "자원", "scope": "core", "desc": "컨테이너가 넘을 수 없는 상한입니다. CPU는 넘으면 느려지고(스로틀링), 메모리는 넘으면 종료됩니다(OOMKilled).", "doc": "https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/#requests-and-limits" },
    { "id": "qos", "ko": "QoS 클래스", "en": "Quality of Service Class", "cat": "자원", "scope": "core", "desc": "요청·제한 설정에 따라 Guaranteed, Burstable, BestEffort로 나뉘며, 노드 자원이 부족할 때 퇴출 순서에 영향을 줍니다.", "doc": "https://kubernetes.io/docs/concepts/workloads/pods/pod-qos/" },
    { "id": "oomkilled", "ko": "메모리 초과 종료", "en": "OOMKilled", "cat": "자원", "scope": "core", "desc": "컨테이너가 메모리 제한을 넘어 커널에 의해 종료된 상태입니다. 종료 코드는 137입니다.", "doc": "https://kubernetes.io/docs/tasks/configure-pod-container/assign-memory-resource/" },
    { "id": "hpa", "ko": "수평 파드 오토스케일러", "en": "HorizontalPodAutoscaler (HPA)", "cat": "자원", "scope": "core", "desc": "CPU 사용률 같은 지표를 보고 Deployment 등의 레플리카 수를 자동으로 늘리거나 줄이는 객체입니다(autoscaling/v2).", "doc": "https://kubernetes.io/docs/concepts/workloads/autoscaling/horizontal-pod-autoscale/" },
    { "id": "metrics-server", "ko": "메트릭 서버", "en": "metrics-server", "cat": "자원", "scope": "addon", "desc": "노드와 파드의 CPU·메모리 사용량을 모아 metrics.k8s.io API로 제공하는 애드온입니다. kubectl top과 HPA가 사용합니다. (API 정의는 1.37에서 Stable)", "doc": "https://kubernetes.io/docs/tasks/debug/debug-cluster/resource-metrics-pipeline/" },
    { "id": "pv", "ko": "퍼시스턴트 볼륨", "en": "PersistentVolume (PV)", "cat": "스토리지", "scope": "core", "desc": "클러스터에 준비된 실제 저장 공간을 나타내는 객체입니다.", "doc": "https://kubernetes.io/docs/concepts/storage/persistent-volumes/" },
    { "id": "pvc", "ko": "퍼시스턴트 볼륨 클레임", "en": "PersistentVolumeClaim (PVC)", "cat": "스토리지", "scope": "core", "desc": "앱이 필요한 저장 공간의 크기와 접근 방식을 요청하는 객체입니다. 조건에 맞는 PV와 연결됩니다.", "doc": "https://kubernetes.io/docs/concepts/storage/persistent-volumes/#persistentvolumeclaims" },
    { "id": "storageclass", "ko": "스토리지클래스", "en": "StorageClass", "cat": "스토리지", "scope": "core", "desc": "PVC 요청이 들어오면 PV를 자동으로 만드는 방법(프로비저너와 매개변수)을 정의합니다.", "doc": "https://kubernetes.io/docs/concepts/storage/storage-classes/" },
    { "id": "rbac", "ko": "역할 기반 접근 제어", "en": "RBAC", "cat": "보안", "scope": "core", "desc": "누가(주체) 어떤 자원에 어떤 동작(verb)을 할 수 있는지를 Role과 Binding으로 정하는 인가 방식입니다.", "doc": "https://kubernetes.io/docs/reference/access-authn-authz/rbac/" },
    { "id": "role", "ko": "롤·클러스터롤", "en": "Role / ClusterRole", "cat": "보안", "scope": "core", "desc": "허용할 동작 목록입니다. Role은 한 네임스페이스 안에서만, ClusterRole은 클러스터 전체 또는 여러 네임스페이스에 재사용할 수 있습니다.", "doc": "https://kubernetes.io/docs/reference/access-authn-authz/rbac/#role-and-clusterrole" },
    { "id": "rolebinding", "ko": "롤바인딩", "en": "RoleBinding / ClusterRoleBinding", "cat": "보안", "scope": "core", "desc": "Role이나 ClusterRole을 사용자·그룹·ServiceAccount에 연결합니다. RoleBinding은 연결 범위를 한 네임스페이스로 제한합니다.", "doc": "https://kubernetes.io/docs/reference/access-authn-authz/rbac/#rolebinding-and-clusterrolebinding" },
    { "id": "serviceaccount", "ko": "서비스어카운트", "en": "ServiceAccount", "cat": "보안", "scope": "core", "desc": "파드 안의 프로세스가 API 서버에 접근할 때 쓰는 신원입니다. 기본적으로 짧은 수명의 토큰이 자동으로 주입됩니다.", "doc": "https://kubernetes.io/docs/concepts/security/service-accounts/" },
    { "id": "networkpolicy", "ko": "네트워크폴리시", "en": "NetworkPolicy", "cat": "보안", "scope": "core", "desc": "라벨·네임스페이스·IP 기준으로 파드의 들어오는(ingress)·나가는(egress) 통신을 허용 목록으로 제한합니다. 집행은 CNI가 합니다.", "doc": "https://kubernetes.io/docs/concepts/services-networking/network-policies/" },
    { "id": "pss", "ko": "파드 보안 표준", "en": "Pod Security Standards", "cat": "보안", "scope": "core", "desc": "privileged, baseline, restricted 세 단계로 정의한 파드 보안 기준입니다.", "doc": "https://kubernetes.io/docs/concepts/security/pod-security-standards/" },
    { "id": "psa", "ko": "파드 보안 어드미션", "en": "Pod Security Admission", "cat": "보안", "scope": "core", "desc": "네임스페이스 라벨에 따라 파드 보안 표준을 적용하는 내장 어드미션 컨트롤러입니다. enforce, audit, warn 모드가 있습니다.", "doc": "https://kubernetes.io/docs/concepts/security/pod-security-admission/" },
    { "id": "securitycontext", "ko": "보안 컨텍스트", "en": "securityContext", "cat": "보안", "scope": "core", "desc": "실행 사용자, 권한 상승 허용 여부, 리눅스 capability, seccomp 프로필 등 파드·컨테이너의 보안 설정입니다.", "doc": "https://kubernetes.io/docs/tasks/configure-pod-container/security-context/" },
    { "id": "admission", "ko": "어드미션 컨트롤", "en": "Admission Control", "cat": "보안", "scope": "core", "desc": "인증·인가를 통과한 요청을 저장하기 전에 검사하거나 수정하는 단계입니다.", "doc": "https://kubernetes.io/docs/reference/access-authn-authz/admission-controllers/" },
    { "id": "crd", "ko": "커스텀 리소스 정의", "en": "CustomResourceDefinition (CRD)", "cat": "확장", "scope": "core", "desc": "Kubernetes API에 새로운 종류(kind)의 객체를 추가하는 방법입니다.", "doc": "https://kubernetes.io/docs/concepts/extend-kubernetes/api-extension/custom-resources/" },
    { "id": "operator", "ko": "오퍼레이터", "en": "Operator", "cat": "확장", "scope": "ecosystem", "desc": "CRD와 전용 컨트롤러로 특정 앱의 운영 지식을 자동화하는 패턴입니다.", "doc": "https://kubernetes.io/docs/concepts/extend-kubernetes/operator/" },
    { "id": "taint", "ko": "테인트·톨러레이션", "en": "Taint / Toleration", "cat": "스케줄링", "scope": "core", "desc": "테인트는 노드가 파드를 밀어내는 표시이고, 톨러레이션은 파드가 그 표시를 견딜 수 있다는 선언입니다.", "doc": "https://kubernetes.io/docs/concepts/scheduling-eviction/taint-and-toleration/" },
    { "id": "affinity", "ko": "어피니티", "en": "Affinity", "cat": "스케줄링", "scope": "core", "desc": "파드를 특정 라벨의 노드나 다른 파드 근처(또는 멀리)에 배치하도록 하는 규칙입니다.", "doc": "https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/" },
    { "id": "feature-gate", "ko": "기능 게이트", "en": "Feature Gate", "cat": "버전", "scope": "core", "desc": "기능을 켜고 끄는 스위치입니다. Alpha는 기본 꺼짐, Beta는 대개 기본 켜짐, GA(Stable)는 항상 켜짐이 원칙입니다.", "doc": "https://kubernetes.io/docs/reference/command-line-tools-reference/feature-gates/" },
    { "id": "stability", "ko": "기능 성숙도", "en": "Alpha / Beta / Stable (GA)", "cat": "버전", "scope": "core", "desc": "Alpha는 실험적이고 바뀔 수 있으며, Beta는 충분히 시험되었고, Stable은 이후 버전에서도 유지됩니다.", "doc": "https://kubernetes.io/docs/reference/using-api/#api-versioning" },
    { "id": "deprecation", "ko": "폐기 예정·제거", "en": "Deprecation / Removal", "cat": "버전", "scope": "core", "desc": "폐기 예정(deprecated)은 아직 동작하지만 앞으로 제거될 것이라는 예고이고, 제거(removed)는 더 이상 제공되지 않는 상태입니다.", "doc": "https://kubernetes.io/docs/reference/using-api/deprecation-policy/" },
    { "id": "version-skew", "ko": "버전 차이 정책", "en": "Version Skew Policy", "cat": "버전", "scope": "core", "desc": "구성 요소 간에 허용되는 버전 차이입니다. kubectl은 API 서버와 마이너 1 차이까지 지원됩니다.", "doc": "https://kubernetes.io/releases/version-skew-policy/" }
  ]
}
