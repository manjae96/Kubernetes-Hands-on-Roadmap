  "levels": [
    {
      "id": "basic",
      "name": "기본",
      "marker": "●○○",
      "tagline": "클러스터의 구조를 이해하고 앱을 배포·확장·업데이트하며 상태를 읽습니다.",
      "audience": "Linux 명령어와 컨테이너(docker run, 이미지, 포트)를 써 봤지만 Kubernetes는 처음이거나 따라 해 본 정도인 개발자",
      "prereq": [
        "Linux 셸 기본 명령 (cd, ls, cat, 파이프)",
        "컨테이너 이미지와 컨테이너의 차이",
        "환경 준비 과정 완료 (minikube·kubectl 설치)"
      ],
      "prereqCourse": "준비 과정 (환경 준비)",
      "goals": [
        "클러스터 구성 요소와 역할 설명",
        "kubectl로 조회·생성·삭제",
        "Pod·Deployment·Service로 앱 배포",
        "Namespace·Label로 자원 구분",
        "확장·롤링 업데이트·롤백",
        "로그와 이벤트로 상태 확인"
      ],
      "outcomes": [
        "YAML 매니페스트로 웹 앱을 배포하고 Service로 노출한다",
        "레플리카 수를 바꾸고 이미지 버전을 무중단으로 올리고 되돌린다",
        "ImagePullBackOff 같은 배포 실패를 이벤트와 로그로 찾아낸다"
      ],
      "guide": "content/guides/basic.md"
    },
    {
      "id": "intermediate",
      "name": "중급",
      "marker": "●●○",
      "tagline": "설정과 상태 점검, 자원 관리와 자동 확장으로 운영 가능한 앱을 만듭니다.",
      "audience": "Deployment·Service를 YAML로 배포해 봤고, 실제 서비스처럼 설정·상태 점검·자원을 다루고 싶은 개발자",
      "prereq": [
        "기본 과정 수준의 kubectl·YAML 사용",
        "Deployment·Service·Label 개념",
        "HTTP 상태 코드와 환경 변수 개념"
      ],
      "prereqCourse": "기본 과정 (또는 동등한 경험)",
      "goals": [
        "ConfigMap·Secret으로 설정 분리",
        "Liveness·Readiness·Startup Probe 설계",
        "자원 요청·제한과 QoS 이해",
        "PV·PVC·StatefulSet (예정)",
        "HPA로 자동 확장",
        "애플리케이션 장애 분석"
      ],
      "outcomes": [
        "이미지를 다시 빌드하지 않고 설정을 바꿔 배포한다",
        "Probe로 준비되지 않은 파드를 트래픽에서 빼낸다",
        "OOMKilled·CrashLoopBackOff·설정 오류를 진단해 고친다",
        "CPU 사용률 기준으로 레플리카를 자동 조정한다"
      ],
      "guide": "content/guides/intermediate.md"
    },
    {
      "id": "advanced",
      "name": "고급",
      "marker": "●●●",
      "tagline": "권한·네트워크·보안 기준으로 클러스터를 안전하게 나누고 운영 구조를 이해합니다.",
      "audience": "앱 운영은 익숙하고, 여러 팀이 쓰는 클러스터의 권한·네트워크·보안 정책을 설계해야 하는 개발자·운영자",
      "prereq": [
        "중급 과정 수준의 매니페스트 작성",
        "HTTP·TCP 포트와 방화벽 개념",
        "인증(누구인가)과 인가(무엇을 할 수 있나)의 차이"
      ],
      "prereqCourse": "중급 과정 (또는 동등한 경험)",
      "goals": [
        "스케줄링 제어 (예정)",
        "RBAC·ServiceAccount 최소 권한",
        "NetworkPolicy·Pod Security",
        "CRD와 Operator 개념 (예정)",
        "클러스터 업그레이드와 복구 (예정)"
      ],
      "outcomes": [
        "앱마다 필요한 권한만 가진 ServiceAccount를 만든다",
        "기본 차단 후 필요한 통신만 허용하는 NetworkPolicy를 작성한다",
        "Pod Security 기준(restricted)을 통과하는 워크로드를 만든다"
      ],
      "guide": "content/guides/advanced.md"
    }
  ],
